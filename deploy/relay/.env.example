# Copy to .env on the server (never commit .env). docs/setup/relay-deploy.md says how to fill it.

# The relay's domain, e.g. relay.example.com (an A record pointing at this server).
RELAY_DOMAIN=
# This server's public IPv4 address.
TURN_IP=
# coturn's shared secret: 32 or more random characters (openssl rand -base64 33).
TURN_SECRET=
# Who may make an account: invite (needs RELAY_INVITE_CODE), open, or closed.
RELAY_SIGNUP=invite
RELAY_INVITE_CODE=
