#!/bin/sh
# Runs as root when WSL starts this system (wsl.conf [boot]): starts Docker Engine.
# WSL gives boot commands a bare environment: dockerd finds containerd, runc and its
# helpers on PATH.
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
mkdir -p /var/log /var/run
if ! socat -u OPEN:/dev/null UNIX-CONNECT:/var/run/docker.sock 2>/dev/null; then
  rm -f /var/run/docker.sock /var/run/docker.pid
  nohup dockerd >>/var/log/dockerd.log 2>&1 &
fi
