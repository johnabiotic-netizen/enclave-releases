# Copy to .env (git ignored) and fill in. Never commit real secrets.

# Local agent auth. Generate a long random string.
AGENT_TOKEN=change-me-to-a-long-random-string

# Port the local agent listens on (127.0.0.1 only).
AGENT_PORT=8787

# Optional: a test proxy for first-run demos only. Never a real account proxy.
# Format: socks5://user:pass@host:port  OR  http://user:pass@host:port  OR  host:port:user:pass
TEST_PROXY=

# Windows + Docker Desktop usually needs no DOCKER_HOST (dockerode uses the npipe).
# If you must override: DOCKER_HOST=npipe:////./pipe/docker_engine
