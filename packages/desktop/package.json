{
  "name": "@enclave/desktop",
  "version": "0.3.12",
  "private": true,
  "description": "Enclave for Windows: the agent, the profile screens and the viewer in one app.",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "node build.mjs",
    "start": "node build.mjs && electron .",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.main.json",
    "dist": "node build.mjs && electron-builder --win nsis --x64 --publish never",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@enclave/agent": "workspace:*",
    "@enclave/shared": "workspace:*",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/sora": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@m1k1o/neko": "3.2.0",
    "@playwright/test": "1.64.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.2.1",
    "electron-builder": "26.18.1",
    "electron-updater": "6.8.12",
    "esbuild": "0.28.2",
    "flag-icons": "7.6.0",
    "qrcode-generator": "2.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vite": "8.3.5"
  },
  "productName": "Enclave",
  "author": "Enclave",
  "build": {
    "appId": "app.enclave.desktop",
    "productName": "Enclave",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "!dist/**/*.map",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../mobile/dist",
        "to": "mobile"
      },
      {
        "from": "../../testing/reference/windows-firefox-158",
        "to": "reference"
      },
      {
        "from": "wsl",
        "to": "wsl",
        "filter": [
          "enclave-wsl.tar.gz"
        ]
      },
      {
        "from": "notices",
        "to": "notices"
      },
      {
        "from": "../../THIRD_PARTY_NOTICES.md",
        "to": "notices/THIRD_PARTY_NOTICES.md"
      }
    ],
    "asar": true,
    "npmRebuild": false,
    "win": {
      "target": "nsis",
      "icon": "dist/icon.ico",
      "artifactName": "Enclave-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Enclave",
      "installerIcon": "dist/icon.ico",
      "uninstallerIcon": "dist/icon.ico",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "johnabiotic-netizen",
        "repo": "enclave-releases",
        "releaseType": "release"
      }
    ]
  }
}
