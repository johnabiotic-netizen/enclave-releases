{
  "name": "@enclave/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Enclave for Windows: the agent, the profile screens and the viewer in one app.",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "node build.mjs",
    "start": "node build.mjs && electron .",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.main.json"
  },
  "dependencies": {
    "@enclave/agent": "workspace:*",
    "@enclave/shared": "workspace:*",
    "@m1k1o/neko": "3.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.1.0",
    "esbuild": "0.28.2",
    "vite": "8.3.5"
  }
}
