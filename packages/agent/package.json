{
  "name": "@enclave/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "enclave": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "enclave": "node --env-file-if-exists=../../.env dist/cli.js"
  },
  "dependencies": {
    "@enclave/shared": "workspace:*",
    "dockerode": "5.0.1",
    "fastify": "5.12.5"
  },
  "devDependencies": {
    "@types/dockerode": "4.0.2"
  }
}
